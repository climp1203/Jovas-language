# ============================================
#   JOVAS ENVIRONMENT VARIABLES
#   Copy this file to .env and fill in values
#   NEVER commit the actual .env file to git
# ============================================

# ── Authentication ──────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRES=3600

# ── Database ────────────────────────────────
JOVASDB_DIR=./jovasdb_data
JOVASDB_MAX_SIZE_MB=100

# ── Email (SMTP) ────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@yourdomain.com

# ── Security ────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=your_encryption_key_here
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
MAX_REQUEST_SIZE_KB=1024

# ── Rate Limiting ───────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=20

# ── App Settings ────────────────────────────
APP_NAME=Jovas
APP_ENV=development
DEBUG=false
PORT=8080
LOG_LEVEL=info

# ── API Keys (optional) ─────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_for_ai_module
