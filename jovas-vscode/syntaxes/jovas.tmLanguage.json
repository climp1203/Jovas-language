{
  "name": "Jovas",
  "scopeName": "source.jovas",
  "fileTypes": ["jovas", "jo"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#template-strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#storage-keywords" },
    { "include": "#control-keywords" },
    { "include": "#async-keywords" },
    { "include": "#builtin-modules" },
    { "include": "#function-declaration" },
    { "include": "#function-call" },
    { "include": "#class-declaration" },
    { "include": "#class-instantiation" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#self-keyword" },
    { "include": "#identifiers" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jovas",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.jovas",
          "match": "#.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.jovas",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#template-interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.jovas",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#template-interpolation" }
          ]
        }
      ]
    },

    "template-strings": {
      "comment": "Template strings with ${} interpolation",
      "name": "string.template.jovas",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "include": "#template-interpolation" },
        { "include": "#string-escapes" }
      ]
    },

    "template-interpolation": {
      "name": "meta.template.expression.jovas",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.jovas" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.jovas" }
      },
      "patterns": [
        { "include": "#identifiers" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#function-call" }
      ]
    },

    "string-escapes": {
      "name": "constant.character.escape.jovas",
      "match": "\\\\[nrtbf\\\\\"'0]"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.jovas",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.jovas",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.hex.jovas",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        }
      ]
    },

    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.jovas",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.jovas",
          "match": "\\bnull\\b"
        }
      ]
    },

    "keywords": {
      "name": "keyword.control.jovas",
      "match": "\\b(if|else|for|in|while|repeat|return|match|case|try|catch|finally|break|continue)\\b"
    },

    "storage-keywords": {
      "patterns": [
        {
          "name": "storage.type.jovas",
          "match": "\\b(let|const)\\b"
        },
        {
          "name": "storage.modifier.jovas",
          "match": "\\b(expose|import)\\b"
        }
      ]
    },

    "async-keywords": {
      "name": "keyword.control.async.jovas",
      "match": "\\b(async|await|thread|parallel|task)\\b"
    },

    "function-declaration": {
      "name": "meta.function.jovas",
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "keyword.declaration.function.jovas" },
        "2": { "name": "entity.name.function.jovas" }
      }
    },

    "class-declaration": {
      "name": "meta.class.jovas",
      "match": "\\b(class)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.class.jovas" },
        "2": { "name": "entity.name.type.class.jovas" }
      }
    },

    "class-instantiation": {
      "name": "meta.instantiation.jovas",
      "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.type.jovas" }
      }
    },

    "function-call": {
      "name": "meta.function-call.jovas",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.jovas" }
      }
    },

    "self-keyword": {
      "name": "variable.language.self.jovas",
      "match": "\\bself\\b"
    },

    "builtin-modules": {
      "name": "support.class.jovas",
      "match": "\\b(print|input|len|type|str|int|float|bool|range|list|sorted|min|max|abs|round|http|db|database|auth|ai|server|deploy|realtime|log|file|math|json|crypto|time|env|config|rateLimit|socket|email|security|fmt|lint|debug)\\b"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.jovas",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.jovas",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.jovas",
          "match": "(?<![=!<>])=(?![=>])"
        },
        {
          "name": "keyword.operator.arithmetic.jovas",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.pipeline.jovas",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.jovas",
          "match": "=>"
        },
        {
          "name": "keyword.operator.null-safe.jovas",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.interpolation.jovas",
          "match": "\\$\\{"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.jovas",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.array.jovas",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.parameters.jovas",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.jovas",
          "match": "[,:]"
        },
        {
          "name": "punctuation.accessor.jovas",
          "match": "\\."
        }
      ]
    },

    "identifiers": {
      "name": "variable.other.jovas",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
